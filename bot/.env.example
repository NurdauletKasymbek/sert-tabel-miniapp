TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789
BOT_TIMEZONE=Asia/Almaty
MINI_APP_URL=https://your-mini-app-domain.example

# Optional Google Sheets sync
GOOGLE_SHEET_ID=your_google_sheet_id
AUTO_SYNC_SHEETS=false

# Put downloaded Google service account JSON here:
GOOGLE_SERVICE_ACCOUNT_JSON=bot/google-service-account.json

# Alternative manual mode, usually leave empty if JSON file exists:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
