TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789
MANAGER_TELEGRAM_IDS=123456789
BOT_TIMEZONE=Asia/Almaty
MINI_APP_URL=https://your-mini-app-domain.example

# Optional Google Sheets sync
GOOGLE_SHEET_ID=your_google_sheet_id
AUTO_SYNC_SHEETS=false

# Жұмыс орны геолокациясы (бос болса — геотексеру өшеді)
WORKPLACE_LAT=
WORKPLACE_LON=
WORKPLACE_RADIUS_M=200
# Геотексеруден босатылған Telegram ID-лер (үтірмен). Бұл ID-лер кез келген
# жерден КІРУ/ШЫҒУ баса алады — тестілеу/қашықтан белгілеу үшін.
GEO_BYPASS_TELEGRAM_IDS=

# Жалақы есебі: айлық жалақыны бөлетін норма жұмыс күні (әдепкі 26)
MONTHLY_WORK_DAYS=26
# Телефонсыз қызметкерлерді еске салу уақыты (HH:MM, әдепкі 09:30)
PHONELESS_REMINDER_TIME=09:30

# Put downloaded Google service account JSON here:
GOOGLE_SERVICE_ACCOUNT_JSON=bot/google-service-account.json

# Alternative manual mode, usually leave empty if JSON file exists:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
