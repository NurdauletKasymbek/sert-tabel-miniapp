{
  "crons": [
    {
      "path": "/api/scheduled-notifications?mode=evening",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/scheduled-notifications?mode=checkout-reminder",
      "schedule": "55 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
